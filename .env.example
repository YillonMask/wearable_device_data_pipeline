# Oura — personal access token (single-user shortcut, no OAuth dance).
# Generate at https://cloud.ouraring.com/personal-access-tokens
OURA_PERSONAL_ACCESS_TOKEN=

# Whoop — OAuth 2.0 (authorization-code flow). Register an app at
# https://developer.whoop.com. Refresh token is populated by `wearable auth whoop`.
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=http://127.0.0.1:8765/callback
WHOOP_REFRESH_TOKEN=

# Google Health API (Fitbit Air). NOT the legacy Fitbit Web API.
# Register an OAuth client in Google Cloud Console; keep the consent screen
# in TESTING mode with yourself added as a test user (avoids CASA review for
# the Restricted scopes). Refresh token is populated by `wearable auth google`.
GOOGLE_HEALTH_CLIENT_ID=
GOOGLE_HEALTH_CLIENT_SECRET=
GOOGLE_HEALTH_REDIRECT_URI=http://127.0.0.1:8765/callback
GOOGLE_HEALTH_REFRESH_TOKEN=

# Local SQLite database path. Parent directory is created automatically.
DATABASE_PATH=data/wearable.db

# BLE heart-rate capture (run `uv run wearable hr-scan` to discover addresses)
WHOOP_BLE_ADDRESS=
FITBIT_BLE_ADDRESS=
# Optional chest strap (Polar H10, Wahoo TICKR, ...) used as the HR ground-truth
# baseline. When set, hr-capture records it alongside the wearables and
# hr-compare reports each wearable's error against it.
STRAP_BLE_ADDRESS=
